{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(flutter --version)",
      "Bash(flutter pub get)",
      "Bash(flutter pub deps *)",
      "Bash(flutter pub publish --dry-run)",
      "Bash(flutter analyze *)",
      "Bash(flutter analyze)",
      "Bash(flutter test *)",
      "Bash(flutter test)",
      "Bash(dart analyze *)",
      "Bash(dart format *)",
      "Bash(adb devices)",
      "Bash(adb logcat *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:docs.haishinkit.com)"
    ],
    "deny": [
      "Bash(flutter pub publish)",
      "Bash(git push --force *)"
    ]
  }
}
